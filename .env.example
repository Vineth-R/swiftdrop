# SwiftDrop local development environment.
# Copy this file to .env: cp .env.example .env
# Values are safe local placeholders. Never commit real credentials.

APP_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# PostgreSQL (shared instance, one schema per service)
# Compose builds its own URL using the `postgres` service name. Run services
# on the host with DATABASE_URL pointing at localhost.
# ---------------------------------------------------------------------------
POSTGRES_USER=swiftdrop
# Compose builds DATABASE_URL from these values. URL-reserved characters
# (@ : / ? # [ ] %) in POSTGRES_PASSWORD are currently unsupported; use a
# URL-safe password for local development.
POSTGRES_PASSWORD=swiftdrop
POSTGRES_DB=swiftdrop
DATABASE_URL=postgres://swiftdrop:swiftdrop@localhost:5432/swiftdrop?sslmode=disable

# Optional pool overrides (shared postgres helper)
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

# ---------------------------------------------------------------------------
# RabbitMQ
# ---------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=swiftdrop
RABBITMQ_DEFAULT_PASS=swiftdrop
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://swiftdrop:swiftdrop@localhost:5672/
RABBITMQ_EXCHANGE=swiftdrop.events
RABBITMQ_PREFETCH=10
RABBITMQ_HANDLER_TIMEOUT=30s
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY=30s
RABBITMQ_RECONNECT_MIN=1s
RABBITMQ_RECONNECT_MAX=30s

NOTIFICATION_QUEUE=notification.requested.v1
NOTIFICATION_ROUTING_KEY=notification.requested.v1
WEBHOOK_QUEUE=webhook.delivery.requested.v1
WEBHOOK_ROUTING_KEY=webhook.delivery.requested.v1

# ---------------------------------------------------------------------------
# Edge and Mailpit (local email sink)
# Only the gateway, RabbitMQ, and Mailpit publish host ports.
# ---------------------------------------------------------------------------
NGINX_PORT=8080
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---------------------------------------------------------------------------
# Email delivery: Gmail SMTP relay
# Google requires 2-Step Verification and a 16-character App Password.
# The normal account password will not work.
# Put the App Password in your untracked .env only; never commit it.
# Port 587 uses STARTTLS. TLS certificate verification stays enabled;
# certificate revocation checking is not implemented in the sender.
# For local-only email, use SMTP_HOST=mailpit and SMTP_PORT=1025 instead.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vineth.ranathunga@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=vineth.ranathunga@gmail.com
SMTP_FROM_NAME=Swift Drop Support

# ---------------------------------------------------------------------------
# Identity configuration (sessions and login protection).
# JWT_ACCESS_SECRET signs the 15 minute access token and is required. Outside
# APP_ENV=development it must be at least 32 random bytes and not a placeholder.
# Refresh tokens are random values stored only as SHA-256 hashes, so
# JWT_REFRESH_SECRET is not used for signing today.
# LOGIN_MAX_FAILURES consecutive wrong passwords lock the account for
# LOGIN_LOCKOUT_DURATION (API v1.1 section 2.2, 423 ACCOUNT_LOCKED).
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-use-32-or-more-random-characters
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
COOKIE_NAME=sd_access
COOKIE_REFRESH_NAME=sd_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_DURATION=15m
FRONTEND_BASE_URL=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# Shared secret for /internal service-to-service calls (not routed by Nginx).
INTERNAL_TOKEN=change-me-internal-token
