# SwiftDrop local development environment.
# Copy this file to .env for Docker Compose: cp .env.example .env
# The values below are safe local placeholders. Never commit real credentials.

APP_ENV=development
LOG_LEVEL=info

# PostgreSQL (shared instance, one schema per service)
# DATABASE_URL is for running a service directly on the host. Compose builds its
# own URL with the `postgres` service name. No service connects to PostgreSQL yet.
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=swiftdrop
POSTGRES_DB=swiftdrop
POSTGRES_PORT=5432
DATABASE_URL=postgres://swiftdrop:swiftdrop@localhost:5432/swiftdrop?sslmode=disable

# RabbitMQ
# RABBITMQ_URL is for running a worker directly on the host. Compose builds its
# own URL with the `rabbitmq` service name.
RABBITMQ_DEFAULT_USER=swiftdrop
RABBITMQ_DEFAULT_PASS=swiftdrop
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://swiftdrop:swiftdrop@localhost:5672/
RABBITMQ_EXCHANGE=swiftdrop.events
RABBITMQ_PREFETCH=10
RABBITMQ_HANDLER_TIMEOUT=30s
RABBITMQ_MAX_RETRIES=3
RABBITMQ_RETRY_DELAY=30s
RABBITMQ_RECONNECT_MIN=1s
RABBITMQ_RECONNECT_MAX=30s

# Worker queues and routing keys
NOTIFICATION_QUEUE=notification.requested.v1
NOTIFICATION_ROUTING_KEY=notification.requested.v1
WEBHOOK_QUEUE=webhook.delivery.requested.v1
WEBHOOK_ROUTING_KEY=webhook.delivery.requested.v1

# Service ports
IDENTITY_PORT=8081
PARCEL_PORT=8082
PRICING_PORT=8083
MERCHANT_PORT=8084
REALTIME_PORT=8085

# Edge and frontend ports
NGINX_PORT=8080
WEB_PORT=3000
