{
  "name": "realtime",
  "root": "apps/services/realtime",
  "projectType": "application",
  "sourceRoot": "apps/services/realtime",
  "tags": ["go", "service", "http"],
  "implicitDependencies": ["go-common"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "goShared"],
      "outputs": ["{workspaceRoot}/dist/apps/services/realtime"],
      "options": {
        "command": "mkdir -p dist/apps/services/realtime && go build -trimpath -o dist/apps/services/realtime/realtime ./apps/services/realtime"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "goShared"],
      "options": {
        "command": "go test ./apps/services/realtime/..."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "goShared"],
      "options": {
        "command": "files=\"$(gofmt -l apps/services/realtime packages/go-common)\" && test -z \"$files\""
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "go run ./apps/services/realtime"
      }
    }
  }
}
