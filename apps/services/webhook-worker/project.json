{
  "name": "webhook-worker",
  "root": "apps/services/webhook-worker",
  "projectType": "application",
  "sourceRoot": "apps/services/webhook-worker",
  "tags": ["go", "service", "worker"],
  "implicitDependencies": ["go-common"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "goShared"],
      "outputs": ["{workspaceRoot}/dist/apps/services/webhook-worker"],
      "options": {
        "command": "mkdir -p dist/apps/services/webhook-worker && go build -trimpath -o dist/apps/services/webhook-worker/webhook-worker ./apps/services/webhook-worker"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "goShared"],
      "options": {
        "command": "go test ./apps/services/webhook-worker/..."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "goShared"],
      "options": {
        "command": "files=\"$(gofmt -l apps/services/webhook-worker packages/go-common)\" && test -z \"$files\""
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "go run ./apps/services/webhook-worker"
      }
    }
  }
}
