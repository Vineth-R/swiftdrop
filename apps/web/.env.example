# Frontend development overrides. Copy this file to .env.local (untracked).
#
# `nx dev` serves the app on :3000. Next proxies /api/v1 to the gateway, but
# it does not proxy /ws, so live updates need the gateway address directly.
# Production and Docker use the page's own origin and do not need this value.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
