{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "composite": false,
    "declarationMap": false,
    "incremental": false,
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/**/*.spec.ts", "src/**/*.spec.tsx", "vitest.config.mts"],
  "exclude": ["out-tsc", "dist", "node_modules", ".next"]
}
