<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{.Subject}}</title>
<style>
  body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
  table, td { mso-table-lspace: 0; mso-table-rspace: 0; }
  img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; }
  @media only screen and (max-width: 620px) {
    .container { width: 100% !important; }
    .px { padding-left: 20px !important; padding-right: 20px !important; }
    .h1 { font-size: 26px !important; line-height: 32px !important; }
    .btn-wrap, .btn-wrap td { width: 100% !important; }
    .btn-link { display: block !important; }
    .label-cell { display: block !important; width: 100% !important; padding-bottom: 2px !important; }
    .value-cell { display: block !important; width: 100% !important; }
  }
  @media (prefers-color-scheme: dark) {
    .bg-page { background-color: {{.D.Paper}} !important; }
    .bg-card { background-color: {{.D.Surface}} !important; border-color: {{.D.Line}} !important; }
    .bg-soft { background-color: {{.D.Surface2}} !important; }
    .c-text { color: {{.D.Text}} !important; }
    .c-muted { color: {{.D.Muted}} !important; }
    .c-link { color: {{.D.Link}} !important; }
    .b-line { border-color: {{.D.Line}} !important; }
    .b-strong { border-color: {{.D.LineStrong}} !important; }
    .btn-cell { background-color: {{.D.Primary}} !important; }
    .btn-link { color: {{.D.OnPrimary}} !important; }
    .n-info { background-color: {{.D.Info.Tint}} !important; border-color: {{.D.Info.Border}} !important; border-left-color: {{.D.Info.Fg}} !important; }
    .n-success { background-color: {{.D.Success.Tint}} !important; border-color: {{.D.Success.Border}} !important; border-left-color: {{.D.Success.Fg}} !important; }
    .n-warning { background-color: {{.D.Warning.Tint}} !important; border-color: {{.D.Warning.Border}} !important; border-left-color: {{.D.Warning.Fg}} !important; }
    .n-danger { background-color: {{.D.Danger.Tint}} !important; border-color: {{.D.Danger.Border}} !important; border-left-color: {{.D.Danger.Fg}} !important; }
    .t-info { color: {{.D.Info.Fg}} !important; }
    .t-success { color: {{.D.Success.Fg}} !important; }
    .t-warning { color: {{.D.Warning.Fg}} !important; }
    .t-danger { color: {{.D.Danger.Fg}} !important; }
    .step-dot { background-color: {{.D.Primary}} !important; color: {{.D.OnPrimary}} !important; }
  }
</style>
</head>
<body class="bg-page" style="margin:0;padding:0;background-color:{{.L.Paper}};">
<div style="display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;color:transparent;mso-hide:all;">{{.Preheader}}{{.Spacer}}</div>
<table role="presentation" class="bg-page" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:{{.L.Paper}};">
<tr><td align="center" style="padding:32px 12px;">
<table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;">

  <tr><td class="px" style="padding:0 4px 20px 4px;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
      <td style="vertical-align:middle;padding-right:12px;"><img src="cid:{{.LogoCID}}" width="40" height="40" alt="" style="display:block;width:40px;height:40px;border-radius:9px;"></td>
      <td class="c-text" style="vertical-align:middle;font-family:{{.FontDisplay}};font-size:22px;line-height:28px;font-weight:600;letter-spacing:-0.02em;color:{{.L.Text}};">SwiftDrop</td>
    </tr></table>
  </td></tr>

  <tr><td class="bg-card b-line" style="background-color:{{.L.Surface}};border:1px solid {{.L.Line}};border-radius:12px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr><td class="px" style="padding:36px 40px 8px 40px;">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 20px 0;"><tr>
          <td width="8" height="8" style="width:8px;height:8px;background-color:{{.L.Text}};border-radius:8px;font-size:0;line-height:0;" class="step-dot">&nbsp;</td>
          <td width="56" style="width:56px;border-top:2px dotted {{.L.LineStrong}};font-size:0;line-height:0;" class="b-strong">&nbsp;</td>
          <td width="8" height="8" style="width:8px;height:8px;background-color:{{.L.Accent}};border-radius:8px;font-size:0;line-height:0;">&nbsp;</td>
        </tr></table>
        {{if .Eyebrow}}<div class="c-muted" style="font-family:{{.FontBody}};font-size:12px;line-height:16px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:{{.L.Muted}};padding:0 0 8px 0;">{{.Eyebrow}}</div>{{end}}
        <h1 class="h1 c-text" style="margin:0;font-family:{{.FontDisplay}};font-size:30px;line-height:36px;font-weight:600;letter-spacing:-0.02em;color:{{.L.Text}};">{{.Heading}}</h1>
      </td></tr>
      <tr><td class="px" style="padding:20px 40px 36px 40px;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
{{range .Blocks}}{{if eq .Kind "paragraph"}}
          <tr><td class="c-text" style="padding:0 0 16px 0;font-family:{{$.FontBody}};font-size:16px;line-height:25px;color:{{$.L.Text}};">{{range $i, $line := lines .Text}}{{if $i}}<br>{{end}}{{$line}}{{end}}</td></tr>
{{else if eq .Kind "button"}}
          <tr><td style="padding:8px 0 20px 0;">
            <table role="presentation" class="btn-wrap" cellpadding="0" cellspacing="0" border="0"><tr>
              <td class="btn-cell" align="center" bgcolor="{{$.L.Primary}}" style="background-color:{{$.L.Primary}};border-radius:8px;"><a class="btn-link" href="{{.URL}}" style="display:inline-block;padding:14px 28px;font-family:{{$.FontBody}};font-size:16px;line-height:20px;font-weight:600;color:{{$.L.OnPrimary}};text-decoration:none;border-radius:8px;">{{.Label}}</a></td>
            </tr></table>
            <div class="c-muted" style="padding:14px 0 0 0;font-family:{{$.FontBody}};font-size:13px;line-height:19px;color:{{$.L.Muted}};">If the button does not work, copy this link into your browser:<br><a class="c-link" href="{{.URL}}" style="font-family:{{$.FontMono}};font-size:12px;color:{{$.L.Link}};word-break:break-all;">{{.URL}}</a></div>
          </td></tr>
{{else if eq .Kind "details"}}
          <tr><td style="padding:0 0 20px 0;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="b-line" style="border-top:1px solid {{$.L.Line}};">
{{range .Rows}}              <tr>
                <td class="label-cell c-muted b-line" width="38%" valign="top" style="padding:12px 12px 12px 0;border-bottom:1px solid {{$.L.Line}};font-family:{{$.FontBody}};font-size:13px;line-height:20px;color:{{$.L.Muted}};">{{.Label}}</td>
                <td class="value-cell c-text b-line" valign="top" style="padding:12px 0;border-bottom:1px solid {{$.L.Line}};font-family:{{if .IsMono}}{{$.FontMono}}{{else}}{{$.FontBody}}{{end}};font-size:{{if .IsMono}}14{{else}}15{{end}}px;line-height:20px;color:{{$.L.Text}};">{{.Value}}</td>
              </tr>
{{end}}            </table>
          </td></tr>
{{else if eq .Kind "notice"}}
          <tr><td style="padding:0 0 20px 0;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
              <td class="n-{{.Tone}}" style="background-color:{{(tone $.L .Tone).Tint}};border:1px solid {{(tone $.L .Tone).Border}};border-left:4px solid {{(tone $.L .Tone).Fg}};border-radius:8px;padding:16px 18px;">
{{if .Title}}                <div class="t-{{.Tone}}" style="font-family:{{$.FontBody}};font-size:15px;line-height:22px;font-weight:600;color:{{(tone $.L .Tone).Fg}};padding:0 0 4px 0;">{{.Title}}</div>
{{end}}                <div class="c-text" style="font-family:{{$.FontBody}};font-size:15px;line-height:23px;color:{{$.L.Text}};">{{range $i, $line := lines .Text}}{{if $i}}<br>{{end}}{{$line}}{{end}}</div>
              </td>
            </tr></table>
          </td></tr>
{{else if eq .Kind "steps"}}
          <tr><td style="padding:4px 0 12px 0;">
            <div class="c-text" style="font-family:{{$.FontDisplay}};font-size:18px;line-height:24px;font-weight:600;letter-spacing:-0.01em;color:{{$.L.Text}};padding:0 0 12px 0;">{{.Title}}</div>
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
{{range $i, $item := .Items}}              <tr>
                <td width="36" valign="top" style="width:36px;padding:0 0 12px 0;"><table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr><td class="step-dot" align="center" width="24" height="24" style="width:24px;height:24px;background-color:{{$.L.Primary}};border-radius:12px;font-family:{{$.FontBody}};font-size:13px;line-height:24px;font-weight:600;color:{{$.L.OnPrimary}};">{{inc $i}}</td></tr></table></td>
                <td class="c-text" valign="top" style="padding:2px 0 12px 0;font-family:{{$.FontBody}};font-size:15px;line-height:22px;color:{{$.L.Text}};">{{$item}}</td>
              </tr>
{{end}}            </table>
          </td></tr>
{{end}}{{end}}
        </table>
      </td></tr>
    </table>
  </td></tr>

  <tr><td class="px" style="padding:24px 8px 0 8px;" align="left">
    <div class="c-muted" style="font-family:{{.FontBody}};font-size:12px;line-height:18px;color:{{.L.Muted}};">
      {{if .Reason}}{{.Reason}}<br><br>{{end}}
      <strong class="c-text" style="color:{{.L.Text}};">SwiftDrop</strong> &middot; Courier and parcel network for Sri Lanka{{if .SupportEmail}}<br>Questions? Write to <a class="c-link" href="mailto:{{.SupportEmail}}" style="color:{{.L.Link}};">{{.SupportEmail}}</a>.{{end}}{{if .HomeURL}}<br>
      <a class="c-link" href="{{.HomeURL}}" style="color:{{.L.Link}};">{{.HomeLabel}}</a>{{end}}
    </div>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
