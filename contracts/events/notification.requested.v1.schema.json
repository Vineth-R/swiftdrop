{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swiftdrop.local/events/notification.requested.v1",
  "title": "notification.requested.v1",
  "description": "Requests delivery of a notification. The notification worker delivers the email channel over SMTP and dead-letters unsupported channels.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "event_version",
    "occurred_at",
    "producer",
    "data"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "const": "notification.requested.v1"
    },
    "event_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parcel_id", "recipient", "channel", "template"],
      "properties": {
        "parcel_id": {
          "type": "string",
          "format": "uuid",
          "description": "Parcel the notification belongs to. Also stored in notification.notification_logs.parcel_id."
        },
        "recipient": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "enum": ["email", "sms"]
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "description": "Email subject line and first line of the plain-text body."
        },
        "variables": {
          "type": "object",
          "description": "Optional values appended to the body as sorted key: value lines. Must be an object with string values when present.",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
