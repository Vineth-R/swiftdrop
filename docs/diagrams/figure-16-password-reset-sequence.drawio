<mxfile host="app.diagrams.net" agent="SwiftDrop M3" version="24.7.17">
  <diagram id="figure-16" name="Figure 16">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1154" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title2" value="Figure 16. Sequence diagram: password reset" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="note3" value="Reset links are single use and never reveal whether an account exists." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="900" height="20" as="geometry"/></mxCell><mxCell id="m4" value="" style="html=1;rounded=0;curved=0;dashed=1;endArrow=none;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="130" as="sourcePoint"/><mxPoint x="160" y="994" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m5" value="" style="html=1;rounded=0;curved=0;dashed=1;endArrow=none;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="130" as="sourcePoint"/><mxPoint x="560" y="994" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m6" value="" style="html=1;rounded=0;curved=0;dashed=1;endArrow=none;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="130" as="sourcePoint"/><mxPoint x="960" y="994" as="targetPoint"/></mxGeometry></mxCell><mxCell id="actor_browser" value="Browser" style="rounded=1;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="90" y="90" width="140" height="40" as="geometry"/></mxCell><mxCell id="actor_identity" value="Identity service" style="rounded=1;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="490" y="90" width="140" height="40" as="geometry"/></mxCell><mxCell id="actor_email" value="Email service (SMTP)" style="rounded=1;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="890" y="90" width="140" height="40" as="geometry"/></mxCell><mxCell id="m7" value="1 POST /auth/forgot-password {email}" style="html=1;rounded=0;curved=0;endArrow=block;endFill=1;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="190" as="sourcePoint"/><mxPoint x="560" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="step2" value="2 rate limit (IP and email); if an active local account&lt;br&gt;with a password: mark older tokens used, store&lt;br&gt;token hash, 30 minute expiry" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="410" y="249" width="300" height="54" as="geometry"/></mxCell><mxCell id="m8" value="3 202 with the same message for every email" style="html=1;rounded=0;curved=0;endArrow=block;endFill=1;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="362" as="sourcePoint"/><mxPoint x="160" y="362" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m9" value="4 send reset link (in the background)" style="html=1;rounded=0;curved=0;dashed=1;endArrow=block;endFill=1;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="448" as="sourcePoint"/><mxPoint x="960" y="448" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m10" value="5 email delivered; user opens&lt;br&gt;/reset-password?token=..." style="html=1;rounded=0;curved=0;dashed=1;endArrow=block;endFill=1;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="534" as="sourcePoint"/><mxPoint x="160" y="534" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m11" value="6 POST /auth/reset-password {token, newPassword}" style="html=1;rounded=0;curved=0;endArrow=block;endFill=1;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="620" as="sourcePoint"/><mxPoint x="560" y="620" as="targetPoint"/></mxGeometry></mxCell><mxCell id="step7" value="7 check the token (hash, expiry, used_at,&lt;br&gt;active user), then the password rules" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="410" y="679" width="300" height="54" as="geometry"/></mxCell><mxCell id="step8" value="8 one transaction: new password hash,&lt;br&gt;set used_at, clear lock,&lt;br&gt;revoke every refresh token" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="410" y="765" width="300" height="54" as="geometry"/></mxCell><mxCell id="m12" value="9 200, cookies cleared; go to login" style="html=1;rounded=0;curved=0;endArrow=block;endFill=1;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="878" as="sourcePoint"/><mxPoint x="160" y="878" as="targetPoint"/></mxGeometry></mxCell><mxCell id="note13" value="The raw token exists only in the emailed link. It is never stored, logged or returned by the API; only its SHA-256 hash is kept. Step 4 runs after step 3, so the reply time does not depend on the account. Source: docs/report/section_6_5_password_reset.md." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1014" width="1000" height="60" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
