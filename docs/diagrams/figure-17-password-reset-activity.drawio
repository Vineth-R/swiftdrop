<mxfile host="app.diagrams.net" agent="SwiftDrop M3" version="24.7.17">
  <diagram id="figure-17" name="Figure 17">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title2" value="Figure 17. Activity diagram: password reset" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="note3" value="Red boxes are failures or the silent no-token path. The forgot-password reply is the same 202 for every well-formed email." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="1000" height="20" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="315" y="90" width="30" height="30" as="geometry"/></mxCell><mxCell id="a1" value="User selects Forgot password and submits an email&lt;br&gt;(POST /auth/forgot-password)" style="rounded=1;arcSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="160" width="420" height="64" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1" value="Within rate limit&lt;br&gt;(per IP and per email)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="264" width="360" height="84" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1_no" value="429 RATE_LIMITED&lt;br&gt;No token created" style="rounded=1;arcSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="274" width="400" height="64" as="geometry"/></mxCell><mxCell id="e6" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="d1_no"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2" value="Email is well formed?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="388" width="360" height="84" as="geometry"/></mxCell><mxCell id="e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2_no" value="422 VALIDATION_ERROR" style="rounded=1;arcSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="398" width="400" height="64" as="geometry"/></mxCell><mxCell id="e8" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="d2_no"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3" value="Active local account&lt;br&gt;with a password?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="512" width="360" height="84" as="geometry"/></mxCell><mxCell id="e9" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3_no" value="No token, no email.&lt;br&gt;The same 202 response is returned" style="rounded=1;arcSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="522" width="400" height="64" as="geometry"/></mxCell><mxCell id="e10" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3" target="d3_no"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="One transaction: mark older unused tokens used;&lt;br&gt;store SHA-256 hash, configured expiry (default 30m)" style="rounded=1;arcSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="636" width="420" height="64" as="geometry"/></mxCell><mxCell id="e11" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="Return 202 with the generic message;&lt;br&gt;email the reset link in the background" style="rounded=1;arcSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="740" width="420" height="64" as="geometry"/></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" value="User opens the link; the page reads the token and asks&lt;br&gt;for a new password (POST /auth/reset-password)" style="rounded=1;arcSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="844" width="420" height="64" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d4" value="Within rate limit (per IP)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="948" width="360" height="84" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a4" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d4_no" value="429 RATE_LIMITED" style="rounded=1;arcSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="958" width="400" height="64" as="geometry"/></mxCell><mxCell id="e15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d4" target="d4_no"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d5" value="Token present, known, unexpired&lt;br&gt;and unused (user active)?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="1072" width="360" height="84" as="geometry"/></mxCell><mxCell id="e16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d5_no" value="400 INVALID_OR_EXPIRED_RESET_TOKEN&lt;br&gt;Same message for every cause" style="rounded=1;arcSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="1082" width="400" height="64" as="geometry"/></mxCell><mxCell id="e17" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d5" target="d5_no"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d6" value="Password meets the&lt;br&gt;strength rules?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="1196" width="360" height="84" as="geometry"/></mxCell><mxCell id="e18" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d5" target="d6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d6_no" value="422 VALIDATION_ERROR&lt;br&gt;The token is not spent" style="rounded=1;arcSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="1206" width="400" height="64" as="geometry"/></mxCell><mxCell id="e19" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d6" target="d6_no"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a5" value="One transaction: update password hash, set used_at,&lt;br&gt;clear login lock, revoke every refresh token" style="rounded=1;arcSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="1320" width="420" height="64" as="geometry"/></mxCell><mxCell id="e20" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d6" target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a6" value="200 success, cookies cleared;&lt;br&gt;send the user to log in" style="rounded=1;arcSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="1424" width="420" height="64" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="end" value="" style="ellipse;shape=doubleEllipse;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="315" y="1528" width="30" height="30" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a6" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note23" value="Matches Figure 16 steps 1 to 9. Source: docs/report/section_6_5_password_reset.md." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1608" width="1000" height="50" as="geometry"/></mxCell></root></mxGraphModel>
