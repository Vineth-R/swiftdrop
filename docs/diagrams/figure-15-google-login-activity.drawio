<mxfile host="app.diagrams.net" agent="SwiftDrop M3" version="24.7.17">
  <diagram id="figure-15" name="Figure 15">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title2" value="Figure 15. Activity diagram: OAuth 2.0 login with Google" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1000" height="30" as="geometry"/></mxCell><mxCell id="note3" value="Red boxes are failures. In a browser every failure after the callback redirects to /login?error=oauth_failed; the status codes apply when the endpoint is called directly. The callback must present the browser-binding cookie set at login." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="1000" height="20" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="315" y="90" width="30" height="30" as="geometry"/></mxCell><mxCell id="a1" value="User selects Sign in with Google&lt;br&gt;(GET /auth/google/login)" style="rounded=1;arcSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="160" width="420" height="64" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="start" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d0" value="redirectTo empty or a relative path?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="264" width="360" height="84" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a1" target="d0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d0_no" value="422 VALIDATION_ERROR&lt;br&gt;No state is stored; no redirect" style="rounded=1;arcSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="274" width="400" height="64" as="geometry"/></mxCell><mxCell id="e6" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d0" target="d0_no"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a2" value="Store state + PKCE + binding hash; set binding cookie;&lt;br&gt;302 to Google" style="rounded=1;arcSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="388" width="420" height="64" as="geometry"/></mxCell><mxCell id="e7" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d0" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a3" value="User signs in and consents at Google;&lt;br&gt;Google redirects to the callback" style="rounded=1;arcSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="492" width="420" height="64" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1" value="State, binding cookie&lt;br&gt;and expiry valid?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="596" width="360" height="84" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a3" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1_no" value="Redirect /login?error=oauth_failed&lt;br&gt;(400 OAUTH_STATE_INVALID when direct)&lt;br&gt;State is not burned on mismatch" style="rounded=1;arcSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="606" width="400" height="64" as="geometry"/></mxCell><mxCell id="e10" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="d1_no"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2" value="Code present, exchanged and&lt;br&gt;ID token verified?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="720" width="360" height="84" as="geometry"/></mxCell><mxCell id="e11" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d2_no" value="Redirect /login?error=oauth_failed&lt;br&gt;(502 OAUTH_PROVIDER_ERROR when direct)&lt;br&gt;The state is already spent" style="rounded=1;arcSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="730" width="400" height="64" as="geometry"/></mxCell><mxCell id="e12" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="d2_no"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3" value="Google reports the&lt;br&gt;email as verified?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="844" width="360" height="84" as="geometry"/></mxCell><mxCell id="e13" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d3_no" value="Redirect /login?error=oauth_failed&lt;br&gt;(403 FORBIDDEN when direct)" style="rounded=1;arcSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="854" width="400" height="64" as="geometry"/></mxCell><mxCell id="e14" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3" target="d3_no"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a4" value="Find user by google_sub, then email; clear unverified&lt;br&gt;password + revoke sessions; else create CUSTOMER" style="rounded=1;arcSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="968" width="420" height="64" as="geometry"/></mxCell><mxCell id="e15" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d3" target="a4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d4" value="Account active?" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="150" y="1072" width="360" height="84" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a4" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d4_no" value="Redirect /login?error=oauth_failed&lt;br&gt;(403 ACCOUNT_DISABLED when direct)" style="rounded=1;arcSize=14;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="560" y="1082" width="400" height="64" as="geometry"/></mxCell><mxCell id="e17" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d4" target="d4_no"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a5" value="Clear binding cookie; issue SwiftDrop JWT and refresh&lt;br&gt;token as HttpOnly cookies sd_access and sd_refresh" style="rounded=1;arcSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="1196" width="420" height="64" as="geometry"/></mxCell><mxCell id="e18" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d4" target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a6" value="302 to redirectTo or /dashboard" style="rounded=1;arcSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="120" y="1300" width="420" height="64" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="end" value="" style="ellipse;shape=doubleEllipse;fillColor=#ffffff;strokeColor=#000000;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="315" y="1404" width="30" height="30" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a6" target="end"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note21" value="Matches Figure 14 steps 1 to 11. Source: docs/report/section_6_4_google_login.md." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1484" width="1000" height="50" as="geometry"/></mxCell></root></mxGraphModel>
