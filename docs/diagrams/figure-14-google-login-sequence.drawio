<mxfile host="app.diagrams.net" agent="SwiftDrop M3" version="24.7.17">
  <diagram id="figure-14" name="Figure 14">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1326" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title2" value="Figure 14. Sequence diagram: OAuth 2.0 login with Google" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=16;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="note3" value="Google proves identity; SwiftDrop issues its own session. Any failure after step 6 redirects the browser to /login?error=oauth_failed." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="44" width="900" height="20" as="geometry"/></mxCell><mxCell id="m4" value="" style="html=1;rounded=0;curved=0;dashed=1;endArrow=none;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="130" as="sourcePoint"/><mxPoint x="160" y="1166" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m5" value="" style="html=1;rounded=0;curved=0;dashed=1;endArrow=none;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="130" as="sourcePoint"/><mxPoint x="560" y="1166" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m6" value="" style="html=1;rounded=0;curved=0;dashed=1;endArrow=none;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="130" as="sourcePoint"/><mxPoint x="960" y="1166" as="targetPoint"/></mxGeometry></mxCell><mxCell id="actor_browser" value="Browser" style="rounded=1;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="90" y="90" width="140" height="40" as="geometry"/></mxCell><mxCell id="actor_identity" value="Identity service" style="rounded=1;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="490" y="90" width="140" height="40" as="geometry"/></mxCell><mxCell id="actor_google" value="Google" style="rounded=1;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="890" y="90" width="140" height="40" as="geometry"/></mxCell><mxCell id="m7" value="1 GET /auth/google/login?redirectTo=/path" style="html=1;rounded=0;curved=0;endArrow=block;endFill=1;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="190" as="sourcePoint"/><mxPoint x="560" y="190" as="targetPoint"/></mxGeometry></mxCell><mxCell id="step2" value="2 check redirectTo is a relative path;&lt;br&gt;store random state + PKCE verifier&lt;br&gt;(about 10 minutes)" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="410" y="249" width="300" height="54" as="geometry"/></mxCell><mxCell id="m8" value="3 302 to Google with state and&lt;br&gt;code_challenge (scope openid email profile)" style="html=1;rounded=0;curved=0;endArrow=block;endFill=1;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="362" as="sourcePoint"/><mxPoint x="160" y="362" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m9" value="4 sign in and consent" style="html=1;rounded=0;curved=0;endArrow=block;endFill=1;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="448" as="sourcePoint"/><mxPoint x="960" y="448" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m10" value="5 302 to callback with code and state" style="html=1;rounded=0;curved=0;endArrow=block;endFill=1;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="534" as="sourcePoint"/><mxPoint x="160" y="534" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m11" value="6 GET /auth/google/callback?code=...&amp;state=..." style="html=1;rounded=0;curved=0;endArrow=block;endFill=1;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="620" as="sourcePoint"/><mxPoint x="560" y="620" as="targetPoint"/></mxGeometry></mxCell><mxCell id="step7" value="7 validate and consume the state&lt;br&gt;(works once; expired or reused = refused)" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="410" y="679" width="300" height="54" as="geometry"/></mxCell><mxCell id="m12" value="8 exchange code + PKCE verifier for tokens" style="html=1;rounded=0;curved=0;endArrow=block;endFill=1;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="792" as="sourcePoint"/><mxPoint x="960" y="792" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m13" value="9 ID token" style="html=1;rounded=0;curved=0;dashed=1;endArrow=block;endFill=1;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="878" as="sourcePoint"/><mxPoint x="560" y="878" as="targetPoint"/></mxGeometry></mxCell><mxCell id="step10" value="10 verify ID token; email must be verified.&lt;br&gt;Find by google_sub, then email (link),&lt;br&gt;or create CUSTOMER; account must be active" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="410" y="937" width="300" height="54" as="geometry"/></mxCell><mxCell id="m14" value="11 302 to redirectTo or /dashboard,&lt;br&gt;Set-Cookie sd_access and sd_refresh" style="html=1;rounded=0;curved=0;endArrow=block;endFill=1;verticalAlign=bottom;fontFamily=Helvetica;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="1050" as="sourcePoint"/><mxPoint x="160" y="1050" as="targetPoint"/></mxGeometry></mxCell><mxCell id="note15" value="Google tokens are used only to learn who the user is and are never stored or used as application tokens. The browser session is always the SwiftDrop token set in step 11. Source: docs/report/section_6_4_google_login.md." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#555555;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="1186" width="1000" height="60" as="geometry"/></mxCell></root></mxGraphModel>
  </diagram>
</mxfile>
